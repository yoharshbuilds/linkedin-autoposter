# Copy to .env and fill in. .env is gitignored.

# One key for BOTH text and image generation (via OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LinkedIn session cookie, ONLY needed when dry_run=false in config.yaml.
# Get it from a logged-in linkedin.com browser session: cookie named "li_at".
LI_AT=
